#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {

    int a, b, c, maior, maior_temp;

    printf("Digite os tres valores a serem comparados: ");
    scanf("%d %d %d", &a, &b, &c);

    // Compara a e b
    maior_temp = ((a + b) + abs(a - b)) / 2;

    // Compara o maior entre a e b com c
    maior = ((maior_temp + c) + abs(maior_temp - c)) / 2;

    printf("O maior entre |%d|%d|%d|: %d\n", a, b, c, maior);

    return 0;
}
