#include <iostream>

using namespace std;

int main() {
	
	int n, r;
	printf("insira o valor: ")
	scanf("%d", &n);
	
	if(n>0){
		r =n*-1;
		}else{
			r = n*n;
		}
		printf("%d",r);
		
		return 0;
	}
	
	
	
