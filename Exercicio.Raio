#include <stdio.h>
#include <stdlib.h>

#define PI 3.14159

int main(int argc, char *argv[]) {

    float raio, area, raioQuadrado;

    printf("Insira o valor do raio: ");
    scanf("%f", &raio);

    raioQuadrado = raio * raio;
    area = PI * raioQuadrado;

    printf("A area do circulo de raio %.2f = %.2f\n", raio, area);


    float b1, b2, h, area2;

    printf("\nInsira o valor da base maior: ");
    scanf("%f", &b1);

    printf("Insira o valor da base menor: ");
    scanf("%f", &b2);

    printf("Insira o valor da altura: ");
    scanf("%f", &h);

    area2 = ((b1 + b2) * h) / 2;

    printf("O valor da area do trapezio = %.2f\n", area2);

    return 0;
}


